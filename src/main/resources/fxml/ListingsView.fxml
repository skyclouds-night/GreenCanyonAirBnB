                                        <ImageView fitHeight="120.0" fitWidth="250.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <Image url="@../static/airbnbpic1.jpg" />
                                            </image>
                                            <VBox.margin>
                                                <Insets left="35.0" top="10.0" />
                                            </VBox.margin>
                                        </ImageView>
                                        <Button mnemonicParsing="false" onAction="#goToListingsView" styleClass="property-name-button" text="Property Name" />
