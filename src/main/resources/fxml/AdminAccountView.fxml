<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="800.0" maxWidth="1000.0" minHeight="800.0" minWidth="1000.0" prefHeight="800.0" prefWidth="1000.0" styleClass="main-container" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ph.edu.dlsu.greencanyonairbnb.controller.AdminAccountViewController">
   <top>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="80.0" styleClass="navbar" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="helloView" mnemonicParsing="false" onAction="#goToHelloView" styleClass="navbar-name" stylesheets="@../css/styles.css" text="GREEN CANYON" />
            <Button fx:id="listingsView" mnemonicParsing="false" onAction="#goToListingsView" styleClass="navbar-buttons" stylesheets="@../css/styles.css" text="Properties" />
            <Button mnemonicParsing="false" onAction="#goToAdminView" styleClass="navbar-buttons" stylesheets="@../css/styles.css" text="Edit Property" />
            <Button mnemonicParsing="false" onAction="#goToAccount" styleClass="navbar-book-now" stylesheets="@../css/styles.css" text="Account" />
         </children>
      </HBox>
   </top>
   <center>
      <ScrollPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <content>
            <VBox maxWidth="980.0" minWidth="980.0" prefWidth="980.0" spacing="30.0">
               <children>
                  <Label styleClass="property-name" text="Welcome, username!">
                     <VBox.margin>
                        <Insets left="50.0" top="20.0" />
                     </VBox.margin>
                  </Label>
                  <StackPane maxHeight="250.0" maxWidth="600.0" minHeight="250.0" minWidth="600.0" prefHeight="250.0" prefWidth="600.0" styleClass="booking" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets left="200.0" />
                     </VBox.margin>
                     <children>
                        <VBox maxHeight="250.0" maxWidth="600.0" minHeight="250.0" minWidth="600.0" prefHeight="250.0" prefWidth="600.0" spacing="25.0">
                           <children>
                              <Label styleClass="notif" text="All Notifications">
                                 <VBox.margin>
                                    <Insets left="20.0" />
                                 </VBox.margin></Label>
                              <Separator prefWidth="200.0">
                                 <VBox.margin>
                                    <Insets left="1.0" right="1.0" />
                                 </VBox.margin></Separator>
                              <Label styleClass="notif-deets" text="Notification #1">
                                 <VBox.margin>
                                    <Insets left="20.0" />
                                 </VBox.margin></Label>
                              <Separator prefWidth="200.0">
                                 <VBox.margin>
                                    <Insets left="1.0" right="1.0" />
                                 </VBox.margin></Separator>
                              <Label styleClass="notif-deets" text="Notification #2">
                                 <VBox.margin>
                                    <Insets left="20.0" />
                                 </VBox.margin></Label>
                           </children>
                           <StackPane.margin>
                              <Insets top="40.0" />
                           </StackPane.margin>
                        </VBox>
                     </children>
                  </StackPane>
                  <StackPane maxHeight="500.0" maxWidth="800.0" minHeight="500.0" minWidth="800.0" prefHeight="500.0" prefWidth="800.0" styleClass="booking">
                     <VBox.margin>
                        <Insets left="100.0" />
                     </VBox.margin>
                     <children>
                        <VBox maxHeight="500.0" maxWidth="800.0" minHeight="500.0" minWidth="800.0" prefHeight="500.0" prefWidth="800.0" spacing="15.0">
                           <children>
                              <Label styleClass="notif" text="All Reservations">
                                 <padding>
                                    <Insets left="20.0" />
                                 </padding></Label>
                              <Separator prefWidth="200.0">
                                 <VBox.margin>
                                    <Insets left="1.0" right="1.0" />
                                 </VBox.margin></Separator>
                              <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
                                 <children>
                                    <VBox maxHeight="100.0" maxWidth="500.0" minHeight="100.0" minWidth="500.0" prefHeight="100.0" prefWidth="500.0" spacing="10.0">
                                       <children>
                                          <Label fx:id = "property" styleClass="notif-deets" text="Property #1" />
                                          <HBox prefHeight="10.0" prefWidth="200.0" spacing="50.0">
                                             <children>
                                                <Label fx:id = "CheckIn" styleClass="notif-deets" text="Check-in Date:" />
                                                <Label fx:id = "Guests" styleClass="notif-deets" text="Amount of Guests:" />
                                             </children>
                                          </HBox>
                                          <Label fx:id = "totalPrice" styleClass="notif-deets" text="Reserved by:" />
                                       </children>
                                    </VBox>
                                    <Button mnemonicParsing="false" styleClass="book-now" text="Accept" />
                                    <Button mnemonicParsing="false" styleClass="book-now" text="Reject" />
                                 </children>
                              </HBox>
                              <Separator prefWidth="200.0">
                                 <VBox.margin>
                                    <Insets left="1.0" right="1.0" />
                                 </VBox.margin></Separator>
                              <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
                                 <children>
                                    <VBox maxHeight="100.0" maxWidth="500.0" minHeight="100.0" minWidth="500.0" prefHeight="100.0" prefWidth="500.0" spacing="10.0">
                                       <children>
                                          <Label styleClass="notif-deets" text="Property #1" />
                                          <HBox prefHeight="10.0" prefWidth="200.0" spacing="50.0">
                                             <children>
                                                <Label styleClass="notif-deets" text="Check-in Date:" />
                                                <Label styleClass="notif-deets" text="Amount of Guests:" />
                                             </children>
                                          </HBox>
                                          <Label styleClass="notif-deets" text="Reserved by:" />
                                       </children>
                                    </VBox>
                                    <Button mnemonicParsing="false" styleClass="book-now" text="Accept" />
                                    <Button mnemonicParsing="false" styleClass="book-now" text="Reject" />
                                 </children>
                              </HBox>
                              <Separator prefWidth="200.0">
                                 <VBox.margin>
                                    <Insets left="1.0" right="1.0" />
                                 </VBox.margin></Separator>
                           </children>
                           <StackPane.margin>
                              <Insets />
                           </StackPane.margin>
                           <padding>
                              <Insets top="30.0" />
                           </padding>
                        </VBox>
                     </children>
                  </StackPane>
                  <StackPane maxHeight="250.0" maxWidth="600.0" minHeight="250.0" minWidth="600.0" prefHeight="250.0" prefWidth="600.0" styleClass="booking">
                     <children>
                        <VBox maxHeight="250.0" maxWidth="600.0" minHeight="250.0" minWidth="600.0" prefHeight="250.0" prefWidth="600.0" spacing="25.0">
                           <children>
                              <Label styleClass="notif" text="Add your QR code.">
                                 <VBox.margin>
                                    <Insets left="20.0" />
                                 </VBox.margin>
                              </Label>
                              <Separator prefWidth="200.0">
                                 <VBox.margin>
                                    <Insets left="1.0" right="1.0" />
                                 </VBox.margin>
                              </Separator>
                              <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                                 <VBox.margin>
                                    <Insets left="200.0" />
                                 </VBox.margin>
                                 <image>
                                    <Image url="@../img/Screenshot%202026-04-11%20151735.png" />
                                 </image>
                              </ImageView>
                           </children>
                           <StackPane.margin>
                              <Insets top="40.0" />
                           </StackPane.margin>
                        </VBox>
                     </children>
                     <VBox.margin>
                        <Insets left="200.0" />
                     </VBox.margin>
                  </StackPane>
                  <Region prefHeight="100.0" prefWidth="200.0" />
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="100.0" styleClass="navbar" stylesheets="@../css/styles.css">
                     <children>
                        <VBox alignment="CENTER" maxHeight="200.0" maxWidth="250.0" minHeight="200.0" minWidth="250.0" prefHeight="200.0" prefWidth="250.0" spacing="15.0">
                           <children>
                              <Label styleClass="footer-title" text="Location" />
                              <Label styleClass="footer-info" text="Taft Avenue, Manila" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" maxHeight="200.0" maxWidth="250.0" minHeight="200.0" minWidth="250.0" prefHeight="200.0" prefWidth="250.0" spacing="15.0">
                           <children>
                              <Label styleClass="footer-title" text="Contact Number" />
                              <Label styleClass="footer-info" text="+63 (912) 345 6789" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" maxHeight="200.0" maxWidth="250.0" minHeight="200.0" minWidth="250.0" prefHeight="200.0" prefWidth="250.0" spacing="15.0">
                           <children>
                              <Label styleClass="footer-title" text="Email" />
                              <Label styleClass="footer-info" text="greencanyon@gmail.com" />
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets top="10.0" />
                     </padding>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
